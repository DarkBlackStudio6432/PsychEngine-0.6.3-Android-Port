<?xml version="1.0" encoding="utf-8"?>
<project>

	<!-- ================= APP ================= -->
	<app
		title="MADNESS INCIDENT 0201A"
		file="MADNESS"
		package="com.shadowmario.madness"
		main="Main"
		version="0.2.8"
		company="dataLand"
	/>

	<set name="APP_ID" value="0x0100f6c013bbc000"/>

	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/>

	<app preloader="flixel.system.FlxPreloader"/>

	<set name="SWF_VERSION" value="11.8"/>

	<!-- ================= WINDOW ================= -->
	<window width="1280" height="720" background="#000000"/>

	<window
		if="mobile"
		orientation="landscape"
		fullscreen="true"
		resizable="false"
		allow-shaders="true"
		require-shaders="true"
		allow-high-dpi="true"
	/>

	<!-- ================= BUILD ================= -->
	<set name="BUILD_DIR" value="export/debug" if="debug"/>
	<set name="BUILD_DIR" value="export/release" unless="debug"/>

	<section if="termux">
		<set name="BUILD_DIR" value="/root/MADNESS/export/debug" if="debug"/>
		<set name="BUILD_DIR" value="/root/MADNESS/export/release" unless="debug"/>
		<android target-sdk-version="34"/>
	</section>

	<classpath name="source"/>

	<!-- ================= DEFINES ================= -->
	<define name="MODS_ALLOWED" if="mobile"/>
	<define name="TOUCH_CONTROLS" if="mobile"/>
	<define name="LUAMPAD_ALLOWED" if="TOUCH_CONTROLS"/>
	<define name="LUA_ALLOWED" if="mobile"/>
	<define name="ACHIEVEMENTS_ALLOWED"/>
	<define name="CRASH_HANDLER" if="mobile"/>
	<define name="PSYCH_WATERMARKS"/>

	<!-- ================= ASSETS ================= -->
	<define name="PRELOAD_ALL"/>
	<define name="NO_PRELOAD_ALL" unless="PRELOAD_ALL"/>

	<assets path="assets/preload" rename="assets"/>
	<assets path="assets/fonts"/>
	<assets path="assets/shared"/>
	<assets path="assets/songs" library="songs"/>
	<assets path="assets/week_assets" library="week_assets"/>

	<section if="TOUCH_CONTROLS">
		<assets path="mobile" rename="assets/mobile"/>
	</section>

	<library name="songs" preload="true"/>
	<library name="shared" preload="true"/>
	<library name="week_assets" preload="true"/>

	<!-- ================= LIBS ================= -->
	<haxelib name="flixel"/>
	<haxelib name="flixel-addons"/>
	<haxelib name="flixel-ui"/>
	<haxelib name="hscript"/>
	<haxelib name="tjson"/>
	<haxelib name="linc_luajit"/>
	<haxelib name="flxanimate"/>
 <haxelib name="extension-androidtools"/>

	<!-- ================= FLAGS ================= -->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN"/>
	<haxedef name="FLX_NO_DEBUG" unless="debug"/>
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug"/>
	<haxedef name="HXCPP_CHECK_POINTER" if="CRASH_HANDLER"/>
	<haxedef name="HXCPP_STACK_LINE" if="CRASH_HANDLER"/>
	<haxedef name="no-deprecation-warnings"/>

	<!-- ================= ANDROID SIGN ================= -->
	<certificate
		path="key.keystore"
		password="psychengine"
		alias="psychport"
		alias-password="psychengine"
		if="android"
		unless="debug"
	/>

	<!-- ================= ICONS ================= -->
	<icon path="art/icon16.png" size="16"/>
	<icon path="art/icon32.png" size="32"/>
	<icon path="art/icon64.png" size="64"/>
	<icon path="art/iconOG.png"/>

</project>